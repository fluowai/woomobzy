# =============================================================================
# IMOBZY CRM - Environment Variables Template
# Copy this file to .env and fill in the values
# NEVER commit .env with real credentials
# =============================================================================

# ─── Supabase ────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# ─── App URLs ────────────────────────────────────────────────────────────────
VITE_PANEL_URL=https://your-domain.com
PUBLIC_APP_URL=https://your-domain.com
VITE_PUBLIC_APP_URL=https://your-domain.com
VITE_API_URL=same-origin

# ─── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://your-domain.com
CORS_ORIGINS=https://your-domain.com

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3002
NODE_ENV=development

# ─── AI Integration (Required for matchmaking) ──────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# ─── WhatsApp ────────────────────────────────────────────────────────────────
VITE_WHATSAPP_API_URL=/api/whatsapp
VITE_WHATSAPP_WS_URL=/api/whatsapp/ws
WHATSAPP_SERVICE_TOKEN=change-me-in-production
WHATSAPP_INTERNAL_TOKEN=change-me-in-production
WHATSAPP_WS_JWT_SECRET=change-me-in-production
WHATSMEOW_URL=http://127.0.0.1:3100
WHATSAPP_API_URL=http://127.0.0.1:3100

# ─── Media Storage (MinIO) ──────────────────────────────────────────────────
MEDIA_STORAGE_PROVIDER=minio
MINIO_ENDPOINT=https://your-minio-endpoint.com
MINIO_PUBLIC_URL=https://your-minio-endpoint.com
VITE_MINIO_PUBLIC_URL=https://your-minio-endpoint.com
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_REGION=us-east-1
MINIO_MEDIA_BUCKET=imobzycrm
MINIO_WHATSAPP_BUCKET=imobzywhatsapp

# ─── Orulo Integration ──────────────────────────────────────────────────────
ORULO_CLIENT_ID=your_orulo_client_id
ORULO_CLIENT_SECRET=your_orulo_client_secret

# ─── DirectAdmin API ────────────────────────────────────────────────────────
DIRECT_ADMIN_URL=https://your-panel:2222
DIRECT_ADMIN_USER=your_da_user
DIRECT_ADMIN_API_KEY=your_da_api_key
WHM_MAIN_DOMAIN=your-domain.com
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-before-running-create-admin-user

# Auditoria E2E autenticada (use somente contas descartáveis de homologação)
IMOBZY_E2E_BASE_URL=http://127.0.0.1:3006
IMOBZY_E2E_URBAN_ADMIN_EMAIL=
IMOBZY_E2E_URBAN_ADMIN_PASSWORD=
IMOBZY_E2E_RURAL_ADMIN_EMAIL=
IMOBZY_E2E_RURAL_ADMIN_PASSWORD=
IMOBZY_E2E_SUPER_ADMIN_EMAIL=
IMOBZY_E2E_SUPER_ADMIN_PASSWORD=
IMOBZY_E2E_MEGA_ADMIN_EMAIL=
IMOBZY_E2E_MEGA_ADMIN_PASSWORD=

# ─── PostgreSQL (Supabase Pooler) ───────────────────────────────────────────
DATABASE_URL="postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require&default_query_exec_mode=simple_protocol"
SUPABASE_DB_URL="postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require&default_query_exec_mode=simple_protocol"
PGSSLMODE=require

# ─── MapBiomas (Rural niche) ───────────────────────────────────────────────
MAPBIOMAS_EMAIL=your_mapbiomas_email
MAPBIOMAS_PASSWORD=your_mapbiomas_password
MAPBIOMAS_POINT_DELTA=0.01

# ─── OmniRoute / WooTech AI ────────────────────────────────────────────────
AI_GATEWAY_URL="http://omniroute:20128/v1"
OMNIROUTE_API_KEY="dummy"

# ─── Licenciamento Wootech ─────────────────────────────────────────────────
# Modo de enforcement do licenciamento no acesso autenticado (fail-open default):
#   off  (padrao) — nunca bloqueia; apenas audita.
#   soft          — bloqueia blocked/revoked/suspended e expirado com politica hard;
#                   carência/expirado soft ficam em modo degradado.
#   hard          — alem do soft, organizacao sem licenca recebe 403.
LICENSE_ENFORCEMENT=off
# Trata organizacao sem licenca como degradada em modo hard (escape pre-rollout).
# Use "on" para tenants ativos desde antes do rollout sem licenca.
LICENSE_ENFORCEMENT_LEGACY_TENANTS=off
# Chaves Ed25519 de assinatura dos envelopes/chaves de licenca (opcional em dev;
# sem elas a assinatura e pulada).
LICENSE_SIGNING_PRIVATE_KEY=
LICENSE_SIGNING_PUBLIC_KEY=

# RabbitMQ & OpenAI Env Vars
RABBITMQ_ERLANG_COOKIE="imobzy_rabbitmq_erlang_cookie_value_32_chars_min"
RABBITMQ_DEFAULT_PASS="imobzy_secret"
RABBITMQ_URL="amqp://imobzy:imobzy_secret@rabbitmq:5672/"
OPENAI_API_KEY="sk-mock-key-for-local-testing"

# â”€â”€â”€ WooSign (Documenso integration) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
DOCUMENSO_API_URL=http://localhost:3000/api/v2
DOCUMENSO_API_TOKEN=your-documenso-api-token
DOCUMENSO_WEBHOOK_SECRET=your-webhook-secret

