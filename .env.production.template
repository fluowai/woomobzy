# ============================================
# WooTech Imob - Production Environment Template
# ============================================
# IMPORTANTE: Preencha com as credenciais reais antes do deploy
# Copie para .env e remova este comentário

# ===================
# SUPABASE (OBRIGATÓRIO)
# ===================
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=CHANGE_ME
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME
SUPABASE_JWT_SECRET=CHANGE_ME
DATABASE_URL=CHANGE_ME
SUPABASE_DB_URL=CHANGE_ME
EMAIL_ENCRYPTION_KEY=gere-uma-chave-hexadecimal-de-64-caracteres

# ===================
# MINIO / S3 (MIDIAS)
# ===================
MINIO_ENDPOINT=https://mypanel.wootech.com.br
MINIO_PUBLIC_URL=https://mypanel.wootech.com.br
VITE_MINIO_PUBLIC_URL=https://mypanel.wootech.com.br
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_APP_ACCESS_KEY=CHANGE_ME
MINIO_APP_SECRET_KEY=CHANGE_ME
MINIO_REGION=us-east-1
MINIO_MEDIA_BUCKET=imobztwootech
MINIO_WHATSAPP_BUCKET=imobztwootech
MINIO_DOCUMENTS_BUCKET=imobztwootech
MINIO_EXPORTS_BUCKET=imobztwootech
MINIO_BACKUPS_BUCKET=imobztwootech

# ===================
# BACKEND SERVER
# ===================
NODE_ENV=production
VITE_API_URL=same-origin
VITE_WHATSAPP_API_URL=/api/whatsapp
VITE_WHATSAPP_WS_URL=/api/whatsapp/ws
WHATSAPP_PROVIDER=whatsmeow
WHATSAPP_API_URL=http://whatsapp-service:3100
WHATSMEOW_URL=http://whatsapp-service:3100
ARRAPHA_API_URL=http://arrapha:3000
WAHA_API_URL=http://arrapha:3000
ARRAPHA_API_KEY=troque-por-um-token-arrapha
WAHA_API_KEY=troque-por-um-token-arrapha
WHATSAPP_INTERNAL_TOKEN=CHANGE_ME
DOCUMENT_WEBHOOK_SECRET=troque-por-um-segredo-longo-e-aleatorio
SIGNATURE_WEBHOOK_SECRET=troque-por-um-segredo-longo-e-aleatorio

# ===================
# RABBITMQ
# ===================
RABBITMQ_DEFAULT_USER=CHANGE_ME
RABBITMQ_DEFAULT_PASS=CHANGE_ME
RABBITMQ_ERLANG_COOKIE=CHANGE_ME
RABBITMQ_URL=CHANGE_ME

# ===================
# INSTAGRAM (DM / CAIXA DE ENTRADA)
# ===================
# Endereco interno do instagram-service visto pelo api (proxy).
INSTAGRAM_SERVICE_URL=http://instagram-service:3200
# Endereco interno do instagram-worker visto pelo instagram-service.
INSTAGRAM_WORKER_URL=http://instagram-worker:8000
# Token compartilhado entre instagram-service e instagram-worker (comunicacao interna).
INSTAGRAM_INTERNAL_TOKEN=troque-por-um-token-longo-e-aleatorio
# Secret para criptografar sessoes/credenciais do Instagram no worker.
INSTAGRAM_ENCRYPTION_SECRET=troque-por-um-segredo-longo-e-aleatorio-de-32-caracteres
# Redis usado pelo BullMQ do Instagram (fila de tarefas do worker).
REDIS_URL=redis://redis:6379

# ===================
# DOMÍNIOS PERMITIDOS (CORS)
# ===================
ALLOWED_ORIGINS=https://imob.wootech.com.br,https://app.wootech.com.br,https://wootech.com.br,https://www.wootech.com.br,https://okaimoveis.com.br,https://www.okaimoveis.com.br,https://fazendasbrasil.com,https://www.fazendasbrasil.com,https://fazendasbrasil.com.br,https://www.fazendasbrasil.com.br
CORS_ORIGINS=https://imob.wootech.com.br,https://app.wootech.com.br,https://wootech.com.br,https://www.wootech.com.br,https://okaimoveis.com.br,https://www.okaimoveis.com.br,https://fazendasbrasil.com,https://www.fazendasbrasil.com,https://fazendasbrasil.com.br,https://www.fazendasbrasil.com.br

# ===================
# AI SERVICES (OPCIONAL)
# ===================
GEMINI_API_KEY=sua-api-key-do-gemini
GROQ_API_KEY=sua-api-key-do-groq
GROQ_MATCH_MODEL=llama-3.1-8b-instant

# ===================
# ORULO (CATALOGO URBANO)
ORULO_CLIENT_ID=seu-client-id-da-orulo
ORULO_CLIENT_SECRET=seu-client-secret-da-orulo
ORULO_CREDENTIALS_ENCRYPTION_KEY=gere-uma-chave-forte-com-pelo-menos-32-caracteres
ORULO_WEBHOOK_SECRET=gere-um-segredo-exclusivo-para-webhooks

# VIVAREAL (PORTAL DE IMOVEIS)
VIVAREAL_API_KEY=sua-api-key-vivareal
VIVAREAL_PARTNER_ID=seu-partner-id-vivareal

# ZAP IMOVEIS (PORTAL DE IMOVEIS)
ZAP_API_KEY=sua-api-key-zap
ZAP_PARTNER_ID=seu-partner-id-zap

# ===================
# WHM/cPanel (OPCIONAL)
# ===================
WHM_HOST=seu-servidor-whm.com
WHM_USER=root
WHM_TOKEN=seu-token-whm
WHM_MAIN_DOMAIN=wootech.com.br
PUBLIC_APP_URL=https://imob.wootech.com.br
VITE_PUBLIC_APP_URL=https://imob.wootech.com.br
VITE_PANEL_URL=https://imob.wootech.com.br
PLATFORM_PUBLIC_IP=207.58.153.219
VITE_PLATFORM_IP=207.58.153.219

# ===================
# TRAEFIK / SSL AUTOMATICO
# ===================
# O backend escreve configs dinamicas de dominio nesta pasta.
# No docker-compose.yml ela e montada em /traefik/dynamic.
TRAEFIK_DYNAMIC_DIR=/traefik/dynamic

# Email usado no resolver ACME do Traefik. Atualize tambem em traefik/traefik.yml
# antes do primeiro deploy.
LETSENCRYPT_EMAIL=admin@wootech.com.br

# ===================
# VERIFICATION TOKEN
# ===================
VERIFY_DOMAIN_TOKEN=token-aleatorio-para-verificacao

# ===================
# LOGGING
# ===================
LOG_LEVEL=info
WHATSAPP_SERVICE_TOKEN=CHANGE_ME
WHATSAPP_INTERNAL_TOKEN=CHANGE_ME
WHATSAPP_WS_JWT_SECRET=CHANGE_ME
DOCUMENT_WEBHOOK_SECRET=replace-with-a-dedicated-document-worker-secret
SIGNATURE_WEBHOOK_SECRET=replace-with-a-dedicated-signature-webhook-secret

# ===================
# MAPBIOMAS ALERTA
# ===================
MAPBIOMAS_EMAIL=seu-email-mapbiomas
MAPBIOMAS_PASSWORD=sua-senha-mapbiomas
# Opcional: use token direto se preferir nao autenticar por email/senha.
MAPBIOMAS_API_TOKEN=
MAPBIOMAS_POINT_DELTA=0.01
